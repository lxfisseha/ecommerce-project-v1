APP_ENV=production

POSTGRES_DB=xcollections
POSTGRES_USER=xcollections
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://xcollections:change-me@postgres:5432/xcollections

SECRET_KEY=change-me

# Product images live on the local filesystem and are served from /media.
# In Docker this is the media_data volume; do not use a container path here
# unless the volume is mounted at the same location.
MEDIA_ROOT=/app/media
REDIS_URL=redis://redis:6379

AFROMESSAGES_API_KEY=
AFROMESSAGES_FROM=
AFROMESSAGES_SENDER=XCollections
AFROMESSAGES_CALLBACK=

AUTH_CHEAT_PIN=